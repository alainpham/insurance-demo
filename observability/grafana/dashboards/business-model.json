{
  "uid": "assurance-business",
  "title": "Assurance — Business model",
  "tags": ["assurance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "The two revenue lines",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Members covered",
      "description": "Members under accepted quotes.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(assurance_portfolio_members_covered)" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "graphMode": "none", "textMode": "value", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Subscription revenue / month",
      "description": "This is the revenue. The per-member subscription is where Assurance makes its money.",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(assurance_portfolio_subscription_revenue_month_eur)" }],
      "fieldConfig": { "defaults": { "unit": "currencyEUR", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "graphMode": "area", "textMode": "value", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Premium volume / month",
      "description": "Priced to break even against expected claims. Target margin: zero.",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(assurance_portfolio_premium_volume_month_eur)" }],
      "fieldConfig": { "defaults": { "unit": "currencyEUR", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "graphMode": "area", "textMode": "value", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Quotes accepted",
      "gridPos": { "h": 4, "w": 4, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(assurance_quotes_by_state{state=\"ACCEPTED\"}) or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "graphMode": "none", "textMode": "value", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Premium discounts refused",
      "description": "Attempts to discount the premium, refused with 422. The business model, enforced in code.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(assurance_pricing_premium_discount_refused_total) or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "options": { "graphMode": "area", "textMode": "value", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Where the money comes from",
      "description": "The premium pays claims; the subscription pays Assurance. Keeping them apart is the whole model.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(assurance_portfolio_premium_volume_month_eur)", "legendFormat": "Premium (pays claims, no margin)" },
        { "refId": "B", "expr": "sum(assurance_portfolio_subscription_revenue_month_eur)", "legendFormat": "Subscription (the revenue)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 25, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Premium (pays claims, no margin)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "Subscription (the revenue)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "type": "bargauge",
      "title": "Average pooling weight Z, by company size",
      "description": "Z = how much of the price comes from the organisation's own claims. Small and new means heavily pooled, which is the protection being sold.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (size_band) (assurance_pricing_credibility_z_sum) / sum by (size_band) (assurance_pricing_credibility_z_count)",
          "legendFormat": "{{size_band}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1, "decimals": 2,
          "color": { "mode": "continuous-BlYlRd" }
        },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "How the price is built",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Average premium per member / month, by industry",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (industry) (assurance_pricing_premium_per_member_month_eur_sum) / sum by (industry) (assurance_pricing_premium_per_member_month_eur_count)",
          "legendFormat": "{{industry}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyEUR", "decimals": 0, "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "bargauge",
      "title": "Expected claims per member / year, by industry",
      "description": "The peer-group forecast the premium is built from.",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (industry) (assurance_pricing_expected_claims_per_member_year_eur_sum) / sum by (industry) (assurance_pricing_expected_claims_per_member_year_eur_count)",
          "legendFormat": "{{industry}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyEUR", "decimals": 0, "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "piechart",
      "title": "Pricings by underwriting appetite",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (out_of_appetite) (assurance_pricing_total)", "legendFormat": "out of appetite: {{out_of_appetite}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "pieType": "donut", "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "type": "text",
      "title": "What is not here",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 24 },
      "options": {
        "mode": "markdown",
        "content": "**Loss ratio (claims ÷ premiums) is deliberately absent.** It is the metric this business model is steered by, and it needs a year of real claims against active contracts — which means `contract-service`, out of scope for this demo (see ARCHITECTURE.md §10). Everything above comes from quotes actually priced by `pricing-service`, not from fixtures."
      }
    }
  ]
}
