{
  "uid": "assurance-funnel",
  "title": "Assurance — Sales funnel",
  "tags": ["assurance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Requests received",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [{ "refId": "A", "expr": "sum(assurance_quote_requests_total) or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "graphMode": "area", "textMode": "value", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Conversion to accepted",
      "description": "Accepted quotes as a share of every quote produced.",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "expr": "(sum(assurance_quotes_by_state{state=\"ACCEPTED\"}) or vector(0)) / clamp_min(sum(assurance_quotes_by_state), 1)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1, "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.15 }, { "color": "green", "value": 0.3 }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "textMode": "value", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Time to a priced quote (p95)",
      "description": "From form submission to a quote with a price on it — the automated part of the process.",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(assurance_time_to_quote_seconds_bucket[$__rate_interval])))" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 15 }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "textMode": "value", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Open tasks",
      "gridPos": { "h": 4, "w": 4, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [{ "refId": "A", "expr": "sum(assurance_tasks_open) or vector(0)" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 50 }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "textMode": "value", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Oldest task waiting",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [{ "refId": "A", "expr": "max(assurance_tasks_oldest_open_minutes) or vector(0)" }],
      "fieldConfig": {
        "defaults": {
          "unit": "m", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 240 }, { "color": "red", "value": 1440 }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "textMode": "value", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "bargauge",
      "title": "The funnel — quotes by state",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [{ "refId": "A", "expr": "sum by (state) (assurance_quotes_by_state)", "legendFormat": "{{state}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Quotes moving through the process",
      "description": "State transitions per minute, by destination state.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "expr": "sum by (to_state) (rate(assurance_quote_transitions_total[$__rate_interval])) * 60", "legendFormat": "{{to_state}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Open tasks by role",
      "description": "The employee work queue. A rising line here is the process backing up on people, not on machines.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "expr": "sum by (role) (assurance_tasks_open)", "legendFormat": "{{role}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "How cases are routed",
      "description": "Straight-through versus referred to an actuary.",
      "gridPos": { "h": 9, "w": 6, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (assurance_workflows_started_total)", "legendFormat": "{{route}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "piechart",
      "title": "Task outcomes",
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (assurance_tasks_completed_total)", "legendFormat": "{{outcome}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "pieType": "donut", "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    }
  ]
}
